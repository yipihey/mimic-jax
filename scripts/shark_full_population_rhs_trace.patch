 namespace shark {
 
+namespace {
+
+constexpr std::size_t mimic_jax_trace_width = 70;
+
+void write_mimic_jax_trace(
+		double t,
+		const double y[],
+		const double f[],
+		const BasicPhysicalModel::solver_params &params,
+		double sfr,
+		double jrate,
+		double beta1,
+		double beta2,
+		double betaj1,
+		double betaj2,
+		double beta_qso1,
+		double beta_qso2,
+		double zcold,
+		double zhot,
+		double yield_eff)
+{
+	const char *path = std::getenv("MIMIC_JAX_SHARK_RHS_TRACE");
+	if (!path || !*path) {
+		return;
+	}
+	static std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+	static std::mutex mutex;
+	double record[mimic_jax_trace_width] = {};
+	std::size_t index = 0;
+	record[index++] = 20260820.0;
+	record[index++] = static_cast<double>(params.galaxy_id);
+	record[index++] = static_cast<double>(params.subhalo_id);
+	record[index++] = static_cast<double>(params.snapshot);
+	record[index++] = params.burst ? 1.0 : 0.0;
+	record[index++] = t;
+	for (std::size_t i = 0; i != 19; ++i) record[index++] = y[i];
+	for (std::size_t i = 0; i != 19; ++i) record[index++] = f[i];
+	record[index++] = params.rgas;
+	record[index++] = params.rstar;
+	record[index++] = params.mcoolrate;
+	record[index++] = params.zcool;
+	record[index++] = params.jcold_halo;
+	record[index++] = params.delta_t;
+	record[index++] = params.redshift;
+	record[index++] = params.vsubh;
+	record[index++] = params.vgal;
+	record[index++] = params.smbh.mass;
+	record[index++] = params.smbh.mass_metals;
+	record[index++] = params.smbh.macc_hh;
+	record[index++] = params.smbh.macc_sb;
+	record[index++] = params.smbh.massembly;
+	record[index++] = params.smbh.spin;
+	record[index++] = sfr;
+	record[index++] = jrate;
+	record[index++] = beta1;
+	record[index++] = beta2;
+	record[index++] = betaj1;
+	record[index++] = betaj2;
+	record[index++] = beta_qso1;
+	record[index++] = beta_qso2;
+	record[index++] = zcold;
+	record[index++] = zhot;
+	record[index++] = yield_eff;
+	if (index != mimic_jax_trace_width) {
+		std::abort();
+	}
+	std::lock_guard<std::mutex> lock(mutex);
+	stream.write(reinterpret_cast<const char *>(record), sizeof(record));
+	if (!stream) {
+		std::abort();
+	}
+}
+
+} // namespace
